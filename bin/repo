#!/usr/bin/env bash
# repo — locate, open, or list repos from repos.yaml. See `repo --help` for usage.

set -euo pipefail

_usage() {
  cat <<'EOF'
repo — locate, open, or list repos from repos.yaml.

Usage:
  repo <name>            echo abs path of matching repo
  repo path <name>       same, explicit form
  repo code <name>       open VSCode at the repo
  repo open <name>       open the repo in the OS file manager (Finder on macOS)
  repo cd <name>         cd into the repo (shell function — needs `eval "$(repo init zsh)"`)
  repo ls                list all repos
  repo init zsh          emit zsh shell integration (use: eval "$(repo init zsh)")
  repo                   fzf picker, print selection
  repo code              fzf picker, then open VSCode
  repo open              fzf picker, then open in OS file manager
  repo -h | --help       show this help

Notes:
  - `repo cd` requires the shell integration (a binary can't change its parent shell's cwd).
    Without it, use:  cd "$(repo <name>)"
  - On ambiguous or no-match queries, fzf opens prefilled with your query.
  - Config: $REPOS_YAML (or $DOTFILES_DIR/repos.yaml).
EOF
}

# Early-exit handlers — work without the yaml present.
case "${1-}" in
  -h|--help|help) _usage; exit 0 ;;
esac

if [[ "${1-}" == "init" ]]; then
  case "${2-}" in
    zsh)
      cat <<'EOF'
# Shell integration for `repo` (dotfiles/bin/repo).
# Defines `repo` as a shell function that intercepts `repo cd <name>` (so it can
# change the parent shell's cwd) and forwards everything else to the binary.
# Also sets up zsh completion.

repo() {
  if [[ "${1-}" == "cd" ]]; then
    shift
    local p
    p="$(command repo path "$@")" || return
    [[ -n "$p" ]] && cd -- "$p"
  else
    command repo "$@"
  fi
}

_repo() {
  local config="${REPOS_YAML:-${DOTFILES_DIR:-$HOME/code/bootstrap/dotfiles}/repos.yaml}"
  [[ -f "$config" ]] || return 1
  local -a repos
  repos=( ${(f)"$(yq -r '.[] | .[] | (split("/") | .[-1] | sub("\.git$"; ""))' "$config" 2>/dev/null)"} )
  _describe 'repo' repos
}
(( ${+functions[compdef]} )) && compdef _repo repo
EOF
      exit 0 ;;
    "")
      echo "repo init: missing shell. Supported: zsh" >&2; exit 2 ;;
    *)
      echo "repo init: unsupported shell '$2'. Supported: zsh" >&2; exit 2 ;;
  esac
fi

CONFIG="${REPOS_YAML:-${DOTFILES_DIR:-$HOME/code/bootstrap/dotfiles}/repos.yaml}"

if [[ ! -f "$CONFIG" ]]; then
  echo "repo: config not found: $CONFIG" >&2
  exit 1
fi

_list() {
  yq -r '
    to_entries | .[] | .key as $dir
    | .value[]
    | (split("/") | .[-1] | sub("\.git$"; "")) as $name
    | $name + "\t" + $dir + "/" + $name
  ' "$CONFIG" | sed "s|\t~|\t$HOME|"
}

_resolve() {
  local query="${1-}" entries matches count
  entries="$(_list)"
  if [[ -n "$query" ]]; then
    matches="$(printf '%s\n' "$entries" \
      | awk -F'\t' -v q="$query" 'BEGIN{IGNORECASE=1} index(tolower($1), tolower(q))')"
    count="$(printf '%s' "$matches" | grep -c . || true)"
    if [[ "$count" == "1" ]]; then
      printf '%s\n' "$matches" | cut -f2
      return
    fi
  fi
  printf '%s\n' "$entries" \
    | fzf --query "$query" --select-1 --height 40% --reverse --with-nth 1 --delimiter '\t' \
    | cut -f2
}

_open_code() {
  local p
  p="$(_resolve "${1-}")"
  [[ -n "$p" ]] && code "$p"
}

_open_in_os() {
  local p
  p="$(_resolve "${1-}")"
  [[ -z "$p" ]] && return
  case "$(uname -s)" in
    Darwin) open "$p" ;;
    Linux)  xdg-open "$p" ;;
    *)      echo "repo open: unsupported OS" >&2; return 1 ;;
  esac
}

case "${1-}" in
  ls)        _list | column -t -s $'\t' ;;
  path)      _resolve "${2-}" ;;
  code)      _open_code "${2-}" ;;
  open)      _open_in_os "${2-}" ;;
  cd)        echo "repo: 'cd' is shell-only. Add 'eval \"\$(repo init zsh)\"' to your zshrc, or use: cd \"\$(repo path \"\${2:-}\")\"" >&2; exit 2 ;;
  "")        _resolve "" ;;
  *)         _resolve "$1" ;;
esac
